API_HOST=localhost
API_PORT=8000
API_URL=http://${API_HOST}:${API_PORT}/api
WS_URL=ws://${API_HOST}:${API_PORT}

FRONTEND_HOST=localhost
FRONTEND_PORT=4300
FRONTEND_URL=http://${FRONTEND_HOST}:${FRONTEND_PORT}

# if you are not using docker, change this to localhost
POSTGRES_HOST = db

POSTGRES_USER=tapiz_user
POSTGRES_PASSWORD=tapiz_password
POSTGRES_DB = tapiz

 # Docker db public port
POSTGRES_PORT_HOST = 5432

# Configure Google, OIDC, or both.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generic OpenID Connect provider (for example Keycloak:
# https://idp.example.com/realms/example). Redirect URI:
# ${API_URL}/auth/oidc/callback
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
# Leave empty only for a public client.
OIDC_CLIENT_SECRET=""
OIDC_DISPLAY_NAME="Single sign-on"

# Local-development AI screenshot login using a personal API token.
# The route is unavailable unless NODE_ENV=development.
AI_AGENT_LOGIN_ENABLED=false

# SMTP configuration for notification emails
# Replace with your SMTP server credentials
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Optional from address
SMTP_FROM=""
SMTP_SECURE=false
